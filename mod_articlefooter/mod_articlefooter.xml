<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_ARTICLEFOOTER</name>
    <author>Magnum</author>
    <authorUrl>https://www.magnumblog.space</authorUrl>
    <copyright>(C) 2026 Magnum. All rights reserved.</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE</license>
    <creationDate>2026-10</creationDate>
    <version>1.2.2</version>
    <description>MOD_ARTICLEFOOTER_XML_DESCRIPTION</description>
    <namespace path="src">Magnum\Module\ArticleFooter</namespace>
    <files>
        <folder module="mod_articlefooter">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
        <filename>LICENSE</filename>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="categories"
                    type="category"
                    label="MOD_ARTICLEFOOTER_CATEGORIES"
                    description="MOD_ARTICLEFOOTER_CATEGORIES_DESC"
                    extension="com_content"
                    multiple="true"
                    layout="joomla.form.field.list-fancy-select"
                />
                <field
                    name="include_subcategories"
                    type="radio"
                    label="MOD_ARTICLEFOOTER_SUBCATEGORIES"
                    description="MOD_ARTICLEFOOTER_SUBCATEGORIES_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                    >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="excluded_categories"
                    type="category"
                    label="MOD_ARTICLEFOOTER_EXCL_CATEGORIES"
                    description="MOD_ARTICLEFOOTER_EXCL_CATEGORIES_DESC"
                    extension="com_content"
                    multiple="true"
                    layout="joomla.form.field.list-fancy-select"
                />
                <field
                    name="excluded_articles"
                    type="text"
                    label="MOD_ARTICLEFOOTER_EXCL_ARTICLES"
                    description="MOD_ARTICLEFOOTER_EXCL_ARTICLES_DESC"
                    hint="12, 57, 103"
                />
                <field
                    name="forum_field"
                    type="sql"
                    label="MOD_ARTICLEFOOTER_FIELD"
                    description="MOD_ARTICLEFOOTER_FIELD_DESC"
                    query="SELECT id, title FROM #__fields WHERE context = 'com_content.article' AND state = 1 ORDER BY title"
                    key_field="id"
                    value_field="title"
                    header="MOD_ARTICLEFOOTER_FIELD_SELECT"
                />
                <field
                    name="html"
                    type="textarea"
                    label="MOD_ARTICLEFOOTER_HTML"
                    description="MOD_ARTICLEFOOTER_HTML_DESC"
                    rows="14"
                    cols="60"
                    filter="raw"
                    class="font-monospace"
                    default="&lt;a class=&quot;btn btn-primary&quot; href=&quot;{forum_url}&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Перейти до обговорення матеріалу&lt;/a&gt;"
                />
                <field
                    name="prepare_content"
                    type="radio"
                    label="MOD_ARTICLEFOOTER_PREPARE"
                    description="MOD_ARTICLEFOOTER_PREPARE_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    filter="integer"
                    >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    validate="moduleLayout"
                />
                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    rows="1"
                    validate="CssIdentifier"
                />
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" priority="1" name="Article Footer (custom HTML)">https://www.magnumblog.space/mod_articlefooter-update.xml</server>
    </updateservers>
</extension>
